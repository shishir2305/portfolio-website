# Set your final public origin before building for deployment.
# No trailing path. Used for canonical URLs, sitemap, social URLs and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Server-only contact form delivery (never prefix these with NEXT_PUBLIC_).
RESEND_API_KEY=
# Use an address on a domain you have verified in Resend.
CONTACT_FROM_EMAIL="Shishir Jha <contact@your-domain.com>"
# Optional; defaults to profile.email in src/content/portfolio.ts.
CONTACT_TO_EMAIL=shishir230501@gmail.com
